{
  "mcpServers": {
    "code-search": {
      "command": "mcp-vector-search",
      "env": {
        "CODEBASE_PATH": "/absolute/path/to/your/codebase",
        "DB_NAME": "my_codebase",

        "EMBEDDING_PROVIDER": "voyage",

        "VOYAGE_API_KEY": "YOUR_VOYAGE_API_KEY_HERE",
        "VOYAGE_EMBEDDING_MODEL": "voyage-3-large",

        "_VOYAGE_CONTEXT_MODEL_DOC": "For contextual embeddings, set VOYAGE_EMBEDDING_MODEL to voyage-context-4 (or voyage-context-3): each chunk is embedded with the whole document as context. Use small chunks and let the settings below apply.",
        "_VOYAGE_ENABLE_CHUNKING": "true",
        "_VOYAGE_MAX_CHUNK_TOKENS": "64  (tokens per chunk; small chunks work best for contextual models)",
        "_VOYAGE_MAX_DOC_TOKENS": "25600  (a document whose chunks exceed this is split into parts so each part fits the model's 32000-token context window; keep < 32000)",

        "_OPENAI_API_KEY": "YOUR_OPENAI_API_KEY_HERE (uncomment if EMBEDDING_PROVIDER=openai)",
        "_OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",

        "_OLLAMA_BASE_URL": "http://localhost:11434 (uncomment if EMBEDDING_PROVIDER=ollama)",
        "_OLLAMA_EMBEDDING_MODEL": "snowflake-arctic-embed2",

        "SEMANTIC_SEARCH_N_RESULTS": "20",
        "MAX_RESULTS": "10",
        "RERANKER_ENABLED": "true",
        "RERANKER_THRESHOLD": "0.5",
        "AI_FILTER_ENABLED": "false",

        "PREVIEW_LINES_VECTORIZATION": "-1",
        "PREVIEW_LINES_STORAGE": "-1",

        "_PREVIEW_CHARS_OUTPUT_DOC": "0 = paths + scores only (agentic flow); N = first N chars per file; -1 = full file",
        "PREVIEW_CHARS_OUTPUT": "0"
      }
    }
  }
}
